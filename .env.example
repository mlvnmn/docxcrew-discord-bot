# Discord Application Credentials
# You can use either DISCORD_TOKEN or TOKEN
TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here

# Roles Configuration (Names of the roles on your server)
VISITOR_ROLE=Visitor
CREW_ROLE=Crew
CORE_ROLE=core

# Channels Configuration (Defaults to channel names below)
# The bot will dynamically search for channels with these names or IDs.
WELCOME_CHANNEL=welcome
ROLES_CHANNEL=roles
CREW_REQUESTS_CHANNEL=crew-requests
JOIN_LOG_CHANNEL=join-logs
EXIT_LOG_CHANNEL=exit-logs
INVITE_TRACKER_CHANNEL=invite-tracker
DMS_CHANNEL=dms

# Optional: You can also specify exact IDs instead of names
# VISITOR_ROLE_ID=123456789012345678
# CREW_ROLE_ID=123456789012345678
# ROLES_CHANNEL_ID=123456789012345678
# CREW_REQUESTS_CHANNEL_ID=123456789012345678
# JOIN_LOG_CHANNEL_ID=123456789012345678
# EXIT_LOG_CHANNEL_ID=123456789012345678
# INVITE_TRACKER_CHANNEL_ID=123456789012345678
# DMS_CHANNEL_ID=123456789012345678

# Branding
SERVER_NAME="DOCX CREW"
